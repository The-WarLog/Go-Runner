{
  "name": "go-runner",
  "displayName": "",
  "description": "",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/The-WarLog/Go-Runner.git"
  },
  "icon": "assets/image.png",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "go-runner.runGo",
        "title": "Run",
        "icon":"$(play)"
      },
      {
        "command": "go-runner.toggleAutoRun",
        "title": "Auto Run",
        "icon":"$(sync)"
      }
    ],
    "menus": {
      "editor/title": [
    {
      "command": "go-runner.runGo",
      "when": "editorLangId == go",
      "group": "navigation"
    },
    {
      "command": "go-runner.toggleAutoRun",
      "when": "editorLangId == go",
      "group": "navigation"
    }
  ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.120.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
